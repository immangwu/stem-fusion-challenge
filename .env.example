# --- Required ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require     # Neon / Vercel Postgres
SESSION_SECRET=change-me-to-a-random-string-of-48-plus-chars   # openssl rand -base64 48
ADMIN_EMAILS=you@college.edu,coordinator@college.edu            # comma-separated bootstrap admins
CRON_SECRET=another-random-string                               # Vercel sends it to the cron route
BLOB_READ_WRITE_TOKEN=                                          # added automatically when you create a Vercel Blob store
ANTHROPIC_API_KEY=                                              # for AI evaluation + custom-topic check

# --- Email (choose ONE) ---
RESEND_API_KEY=                                                 # verified sending domain required for all students
MAIL_FROM="STEM Fusion Challenge <no-reply@yourdomain.edu>"
# SMTP_URL=smtps://user:app-password@smtp.gmail.com:465        # Gmail app-password (about 500 mails/day limit)

# --- Optional ---
BLOB_ACCESS=private          # use "public" only if your Blob store is public
AI_MODEL=claude-sonnet-5-5
AI_CONCURRENCY=6
EVENT_NAME=STEM Fusion Challenge: Think, Build, Prove
